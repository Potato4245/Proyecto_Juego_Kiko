<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080F19">
    <!-- El FrameLayout apila las vistas en orden. La primera contiene las plataformas y los robots y recibe el zoom de la cámara. -->
    <com.example.proyecto_juego_kiko.HangarView android:id="@+id/escena"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <!-- La indicación se muestra en la vista general. SelectorRobot la oculta al tocar una figura. -->
    <TextView android:id="@+id/indicacion"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp"
        android:text="@string/toca_robot" android:textColor="#FFF2DB" android:textSize="18sp"
        android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="2" android:shadowRadius="5" />
    <!-- La ficha empieza oculta. Está fuera de HangarView para mantener su tamaño al acercar la cámara. Se puede desplazar si el texto ocupa más que el alto disponible. -->
    <ScrollView android:id="@+id/ficha" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:background="@drawable/ficha_hangar"
        android:clipToOutline="true" android:elevation="5dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">
            <!-- SelectorRobot rellena estos dos campos con el nombre y la descripción del autómata tocado. -->
            <TextView android:id="@+id/nombre" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="26sp"
                android:fontFamily="serif" android:textColor="#FFD692" />
            <TextView android:id="@+id/descripcion" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="#F0EDE6" android:textSize="15sp" android:lineSpacingExtra="2dp" />
            <!-- Los botones se reparten el ancho y tienen al menos 48 dp de alto. Volver descarta la vista previa y Confirmar guarda la elección. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal">
                <Button android:id="@+id/volver" style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:minWidth="0dp" android:text="@string/no_elegir"
                    android:textAllCaps="false" android:textColor="#F2E8D7"
                    android:background="@drawable/accion_secundaria" />
                <Button android:id="@+id/confirmar" style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:minWidth="0dp" android:layout_marginStart="8dp"
                    android:text="@string/elegir" android:textAllCaps="false" android:textColor="#281D10"
                    android:background="@drawable/accion_elegir" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
