<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    tools:context=".MainActivity">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/fondo_principal"
            android:scaleType="centerCrop"
            android:contentDescription="Fondo de ciudad steampunk" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#55101820" />
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fondo_cristal"
        android:elevation="8dp"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp"
        app:blurOverlayColor="#33101820"
        app:layout_constraintWidth_percent="0.76"
        app:layout_constraintWidth_max="390dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <ImageView
                android:layout_width="100dp"
                android:layout_height="85dp"
                android:layout_gravity="center"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo de Robot Apocalypse"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="EXTRA MACHINE"
                android:textColor="#D6AD60"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="34dp"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="15dp"
                android:background="#9B713B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="INICIAR SESIÓN"
                android:textColor="#F5EBDD"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#C1C5C7"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="17dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#38101820"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_usuario"
                    android:contentDescription="Usuario"
                    android:scaleType="fitCenter" />

                <EditText
                    android:id="@+id/etUsuario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Nombre de usuario"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:textColor="#F5EBDD"
                    android:textColorHint="#C1C5C7"
                    android:textSize="14sp"
                    android:autofillHints="username"
                    android:fontFamily="@font/orbitron"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#38101820"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_candado"
                    android:contentDescription="Contraseña"
                    android:scaleType="fitCenter" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:textColor="#F5EBDD"
                    android:textColorHint="#C1C5C7"
                    android:textSize="14sp"
                    android:autofillHints="password"
                    android:fontFamily="@font/orbitron"/>
            </LinearLayout>

            <TextView
                android:id="@+id/buttonreset"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end|center_vertical"
                android:text="¿Has olvidado tu contraseña?"
                android:fontFamily="@font/orbitron"
                android:textColor="#D6AD60"
                android:textSize="12sp"
                android:paddingEnd="2dp"
                android:layout_marginBottom="9dp" />

            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/boton_login"
                android:backgroundTint="@null"
                android:fontFamily="@font/orbitron"
                android:text="ENTRAR"
                android:textAllCaps="true"
                android:textColor="#251B10"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>
